{
  "expo": {
    "name": "EcoPonto BR",
    "slug": "ecoponto-br",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "ecoponto",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#10B981"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ecoponto.br",
      "infoPlist": {
        "NSCameraUsageDescription": "Tire fotos do lixo reciclável",
        "NSLocationWhenInUseUsageDescription": "Encontre pontos de coleta próximos",
        "NSPhotoLibraryUsageDescription": "Escolha fotos da galeria"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#10B981"
      },
      "package": "com.ecoponto.br",
      "permissions": [
        "CAMERA",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Tire fotos do lixo reciclável"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Encontre pontos próximos"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
